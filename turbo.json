{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ADMIN_EMAILS",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "WEB_ORIGIN",
        "ORIN_GRACE_MS"
      ]
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "ADMIN_EMAILS"
      ]
    }
  }
}
