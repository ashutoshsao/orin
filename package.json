{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d --wait && turbo run dev --filter=api --filter=@repo/web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "docker compose up -d --wait && turbo run test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.10"
  },
  "name": "with-vite",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zod": "^4.5.2"
  }
}
